{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["orcaset-instructions.md"],
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "custom-prettier": {
      "command": ["dune", "ocamlformat"],
      "extensions": [".ml", ".mli"]
    }
  },

//   Disable providers that are auto loaded
  "disabled_providers": ["opencode"],
//   Enable providers (note that disable takes precedence over enable)
  "enabled_providers": ["openrouter"],
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "model": "openrouter/anthropic/claude-sonnet-4-6",
  "small_model": "openrouter/anthropic/claude-haiku-4-5"
}